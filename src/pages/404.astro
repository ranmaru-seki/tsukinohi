---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <section class="container page-hero section">
    <p class="page-hero__en">404</p>
    <h1 class="page-hero__title">ページが見つかりません</h1>
    <p class="page-hero__text">お探しのページは、移動したか削除された可能性があります。</p>
    <p style="margin-top: 40px"><a href="/" class="btn">トップへ戻る</a></p>
  </section>
</BaseLayout>
